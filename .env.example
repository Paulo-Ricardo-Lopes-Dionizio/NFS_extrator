# =========================
# Telegram
# =========================
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ADMIN_USER_IDS=

# =========================
# Certificados / empresa
# Nunca envie certificados ou senhas ao GitHub.
# =========================
EMPRESA_CNPJ=
NFE_CNPJS_EMITENTES_PROPRIOS=
NFE_RAZAO_SOCIAL=
NFE_UF=

NFSE_CERT_PFX=certificado/empresa.pfx
NFE_CERT_PFX=certificado/empresa.pfx
NFE_CERT_SENHA=

# Certificado alternativo para NF-e emitida pela própria empresa, se necessário.
NFE_FILIAL_CNPJ=
NFE_FILIAL_CERT_PFX=certificado/filial.pfx
NFE_FILIAL_CERT_SENHA=

# =========================
# PHP / NF-e
# =========================
PHP_EXE=C:\php\php.exe
NFE_SCRIPT_RECEBIDA=baixar_por_chave_com_manifestacao.php
NFE_SCRIPT_EMITIDA=baixar_emitida.php
NFE_XML_DIR=xml/completos
NFE_TIMEOUT=180

# =========================
# OCR
# =========================
TESSERACT_EXE=C:\Program Files\Tesseract-OCR\tesseract.exe

# =========================
# Destino dos XMLs
# Pode ser pasta local, outra unidade ou compartilhamento de rede UNC.
# Exemplos:
# DESTINO_NFE=D:\Fiscal\NFE
# DESTINO_NFSE=\\SERVIDOR\Fiscal\NFSE
# =========================
DESTINO_NFE=saida/NFE
DESTINO_NFSE=saida/NFSE

# 1 = cria <DESTINO>/<CNPJ-ou-CPF>/<arquivo.xml>
# 0 = salva diretamente na pasta de destino.
CRIAR_SUBPASTA_DOCUMENTO=1

# =========================
# Validação opcional de destinatários
# =========================
EMPRESAS_CERTIFICADAS_ARQUIVO=empresas_certificadas.json
EXIGIR_CNPJ_CADASTRADO=0
